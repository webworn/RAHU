{
  "mcpServers": {
    "google-workspace": {
      "command": "uvx",
      "args": ["workspace-mcp==1.22.0", "--tools", "gmail", "calendar", "tasks", "drive", "docs"],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}",
        "USER_GOOGLE_EMAIL": "${USER_GOOGLE_EMAIL}",
        "WORKSPACE_MCP_DEFAULT_TIMEZONE": "${WORKSPACE_MCP_DEFAULT_TIMEZONE:-UTC}"
      }
    }
  }
}
